Thumbs.db
desktop.ini
*.log
.wrangler/
node_modules/
__pycache__/

# The textbooks, the publisher's contents page and the phone screenshots now
# live in ../Greek App Reference/, outside this repository, where no command
# run in here can reach them at all. See that folder's README for why.
#
# These patterns stay as a second line of defence, in case a copy is ever
# dropped back in. They are not the defence: a .gitignore only protects what
# somebody listed in advance, and hg_toc.pdf reached a commit precisely
# because it post-dated the list.
Black/
Huffman/
Bugs/
hg_toc.pdf

# Audio delivery packs. Every recording arrives as a folder of clips plus a
# cue sheet; the clips are copied into audio/vocab, audio/forms or
# audio/clips and the cue sheet into docs/, and then the pack is deleted —
# nothing in one is the only copy of anything. These patterns keep a pack
# out of the repo for as long as it sits here.
#
# Only the optimised clips ship. The raw masters and WAVs (~19MB) stay
# local in OneDrive.
audio/Erasmian_*/
# Generated clips and pilot files, listened to and moved across by hand
audio/_staging/
audio/*.mp3
audio/*.wav
audio/*.zip
audio/*_cues.json
/erasmian_koine_greek_alphabet.mp3

# Local-only working files
# .claude/launch.json is how this machine serves the app for testing; it is
# a tool setting, not part of the app.
.claude/
audio-audit.html
sound-picker.html
vocab_worklist.tsv
vocab_additions.tsv
extra_forms_worklist.tsv
extra_forms_pack.json
AUDIT.md

# AWS access key downloads. Never in the repo.
*accessKeys*.csv
*credentials*.csv

# Source lexicons, cached by tools/build_lexicon.py. Someone else's data, 5MB,
# and re-fetchable — data/lexicon.js is the thing that ships. Delete this
# directory to pull them again.
tools/_sources/
